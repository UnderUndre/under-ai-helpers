{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_comment": "Permission preset for Claude Code consumers (feature 006 US3). Allow-list: routine read-only/idempotent ops. Deny-list: secret reads + destructive commands. Precedence per data-model.md §4: guard hooks > deny preset > consumer allow.",
  "allow": [
    "Bash(npm test)",
    "Bash(npm test:*)",
    "Bash(npm run test*)",
    "Bash(npm run validate)",
    "Bash(npm run build)",
    "Bash(npm run lint)",
    "Bash(npm run typecheck)",
    "Bash(npm run dev)",
    "Bash(npx vitest*)",
    "Bash(npx tsc*)",
    "Bash(npx eslint*)",
    "Bash(npx prettier*)",
    "Bash(tsc --noEmit)",
    "Bash(git status)",
    "Bash(git status:*)",
    "Bash(git diff*)",
    "Bash(git log*)",
    "Bash(git branch*)",
    "Bash(git show*)",
    "Bash(git remote:*)",
    "Bash(git rev-parse*)",
    "Bash(git stash list)",
    "Bash(git tag:*)",
    "Bash(ls*)",
    "Bash(cat*)",
    "Bash(echo*)",
    "Bash(pwd)",
    "Bash(wc*)",
    "Bash(head*)",
    "Bash(tail*)",
    "Bash(grep*)",
    "Bash(rg*)",
    "Bash(find*)",
    "Bash(node*)",
    "Bash(python*)",
    "Bash(pip list)",
    "Bash(cargo test*)",
    "Bash(cargo check*)",
    "Bash(cargo build*)",
    "Bash(cargo clippy*)",
    "Bash(make help)",
    "Bash(make test*)",
    "Bash(make build*)"
  ],
  "deny": [
    "Read(.env)",
    "Read(.env.*)",
    "Read(**/.ssh/**)",
    "Read(**/*.pem)",
    "Read(**/*.key)",
    "Read(**/id_rsa*)",
    "Bash(rm -rf*)",
    "Bash(rd /s*)",
    "Bash(git push --force*)",
    "Bash(git push -f*)",
    "Bash(git reset --hard*)",
    "Bash(*--force*)",
    "Bash(*--yes*)",
    "Bash(*-y*)",
    "Bash(*--no-verify*)"
  ]
}
