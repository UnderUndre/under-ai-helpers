{
  "name": "underboard",
  "version": "0.1.0",
  "description": "Local-first MCP tool server: shared task board + semantic memory for AI coding agents",
  "type": "module",
  "bin": {
    "underboard": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "imports": {
    "#storage/*": "./dist/storage/*",
    "#tools/*": "./dist/tools/*",
    "#embedding/*": "./dist/embedding/*",
    "#retrieval/*": "./dist/retrieval/*",
    "#project/*": "./dist/project/*",
    "#events/*": "./dist/events/*",
    "#server/*": "./dist/server/*",
    "#cli/*": "./dist/cli/*"
  },
  "files": [
    "dist",
    "dashboard"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "validate": "tsc --noEmit",
    "prepublishOnly": "npm run validate && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "mcp",
    "ai",
    "task-board",
    "memory",
    "agents",
    "kanban"
  ],
  "license": "MIT",
  "author": "UnderUndre",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnderUndre/ai.git",
    "directory": "packages/underboard"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.0.0",
    "c12": "^2.0.0",
    "commander": "^13.0.0",
    "consola": "^3.0.0",
    "dompurify": "^3.0.0",
    "jsdom": "^26.0.0",
    "onnxruntime-node": "^1.21.0",
    "sqlite-vec": "^0.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/dompurify": "^3.0.0",
    "@types/jsdom": "^21.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
