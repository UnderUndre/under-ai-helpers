{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "CC-only ratchet for self-maintaining workflow infrastructure (Step 3 of Option B from /brainstorm). Hooks here DO NOT transpile to Copilot/Gemini — that's by design (hybrid enforcement). Soft baseline lives in CLAUDE.md and propagates everywhere; this layer adds reliability inside Claude Code only. Guard hooks (FR-005/006/007, feature 006) added to PreToolUse(Bash|Read|Grep|Glob) + PostToolUse(Edit|Write).",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/intent-hint.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent-skills-reminder.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-destructive.mjs"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-secrets.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-feedback.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-checkpoint.sh"
          }
        ]
      }
    ]
  }
}
